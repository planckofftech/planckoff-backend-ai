# Required. The frontend sends this as the X-API-Key header.
API_KEY=dev-key

# Set this in every deployment. It turns the placeholder above from a
# convenience into a refusal to start, so a misconfigured environment fails
# loudly instead of serving every takeoff to anyone who guesses "dev-key".
REQUIRE_REAL_API_KEY=false

# Upload cap. Requests above this are rejected with 413.
MAX_UPLOAD_MB=500

# Comma-separated. The Next.js dev server is allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Without a key the vision fallback is skipped rather than failing --
# the deterministic path needs no credentials at all.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_RENDER_DPI=200

# Optional. Without these the service behaves exactly as it did before there was
# a database: a takeoff is still produced and returned, it is simply not
# remembered. A Supabase outage degrades the product rather than stopping it.
#
# The SERVICE key, not the anon key. This process is trusted and bypasses
# row-level security; the anon key belongs in a browser and never here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stamped on every run_log row. Set it to the build or git sha in a deployment:
# without it, comparing two runs tells you nothing, because you cannot tell what
# was different about them.
APP_VERSION=dev

# Page-finder gates. Fitted to real bid sets; retune with /inspect.
MIN_HEADER_HITS=5
MIN_TAG_RUN=8

LOG_LEVEL=INFO


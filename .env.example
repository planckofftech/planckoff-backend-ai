# Required. The frontend sends this as the X-API-Key header.
API_KEY=dev-key

# Upload cap. Requests above this are rejected with 413.
MAX_UPLOAD_MB=50

# Comma-separated. The Next.js dev server is allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Without a key the vision fallback is skipped rather than failing --
# the deterministic path needs no credentials at all.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_RENDER_DPI=200

# Page-finder gates. Fitted to real bid sets; retune with /inspect.
MIN_HEADER_HITS=5
MIN_TAG_RUN=8

LOG_LEVEL=INFO

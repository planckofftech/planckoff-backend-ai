# Required. The frontend sends this as the X-API-Key header.
API_KEY=dev-key

# Set this in every deployment. It turns the placeholder above from a
# convenience into a refusal to start, so a misconfigured environment fails
# loudly instead of serving every takeoff to anyone who guesses "dev-key".
REQUIRE_REAL_API_KEY=false

# Upload cap. Requests above this are rejected with 413.
MAX_UPLOAD_MB=500

# Comma-separated. The Next.js dev server is allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Without a key the vision fallback is skipped rather than failing --
# the deterministic path needs no credentials at all.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_RENDER_DPI=200

# Finding doors on a plan is a different job from transcribing a table, so it
# gets its own model. Empty means "use AI_MODEL".
AI_DETECT_MODEL=google/gemini-2.5-pro

# Hard ceiling on one plan-audit request, in USD. Deliberately near the cost of
# a single project rather than generous: a run needing more should stop and say
# so. Two projects once cost $6 against a stated $0.70, because the only cap in
# place was per sheet.
DETECT_BUDGET_USD=1.50

# How wide a door should be in the picture the detector sees. Measured: at 80 px
# recall was 78% and boxes landed in empty rooms; at 160 px it was 94% and they
# landed on the doors. The cost of the larger number is more tiles.
AI_DOOR_PIXELS=160

# Most tiles one sheet may be cut into -- a backstop against a loop bug, not a
# cost control; DETECT_BUDGET_USD is the cost control. It matters on a big
# building drawn small: a 1/16" warehouse plan needs about 90 tiles to show
# every door at a readable size, so at 40 the sheet is read in part and the rest
# is reported unread. Raise it and the budget together.
MAX_TILES_PER_SHEET=40

# Optional. Without these the service behaves exactly as it did before there was
# a database: a takeoff is still produced and returned, it is simply not
# remembered. A Supabase outage degrades the product rather than stopping it.
#
# The SERVICE key, not the anon key. This process is trusted and bypasses
# row-level security; the anon key belongs in a browser and never here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stamped on every run_log row. Set it to the build or git sha in a deployment:
# without it, comparing two runs tells you nothing, because you cannot tell what
# was different about them.
APP_VERSION=dev

# Where the drawing sets live. Cloudflare R2 -- it speaks the S3 API, so these
# are S3 credentials pointed somewhere other than AWS.
#
# The browser uploads straight here with a signed link, so a 115 MB set never
# passes through this service: that is what removes every request-size limit
# between the client and storage. The file then stays, because the plan viewer
# re-renders sheets from the original PDF long after the upload finished.
#
# Absent settings are not an error -- uploading the PDF to the API still works,
# and only the signed-link route is unavailable.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# How long a browser has to use an upload link, in seconds.
UPLOAD_URL_TTL=900

# How many drawing sets may be read at once. One peaked at 434 MB, so two
# together is an out-of-memory kill on a 1 GB host -- and the kernel takes the
# whole process, losing both jobs and every request in flight. Raise this with
# the memory, not with the core count.
MAX_CONCURRENT_EXTRACTIONS=1

# Page-finder gates. Fitted to real bid sets; retune with /inspect.
MIN_HEADER_HITS=5
MIN_TAG_RUN=8

LOG_LEVEL=INFO


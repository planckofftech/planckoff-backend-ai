{
  "info": {
    "name": "Planckoff — Door Schedule Extraction API",
    "description": "POC endpoints. Set the {{base_url}} and {{api_key}} collection variables, then pick a PDF in the form-data 'file' field of each extract request.\n\nNOTE: port 8010 by default, because port 8000 is used by the other planckoff-api service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8010", "type": "string" },
    { "key": "api_key", "value": "dev-key", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health (no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
        "description": "Liveness plus whether the AI tier is configured. Expect 200:\n{\"status\":\"ok\",\"version\":\"0.1.0\",\"ai_enabled\":false}"
      }
    },
    {
      "name": "2. Extract door schedule",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Select a PDF. Must be under 50 MB (MAX_UPLOAD_MB)."
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/door-schedule/extract",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "door-schedule", "extract"]
        },
        "description": "The main endpoint. Body must be form-data with key 'file' set to type File.\n\nDo NOT add a Content-Type header manually — Postman sets the multipart boundary itself.\n\nExpect 200 with method=deterministic_ruled, row_count=23 for the Ellis County set."
      }
    },
    {
      "name": "3. Extract with debug scores",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": [] }]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/door-schedule/extract?debug=true&allow_ai=false",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "door-schedule", "extract"],
          "query": [
            { "key": "debug", "value": "true", "description": "adds page_scores for every page" },
            { "key": "allow_ai", "value": "false", "description": "forbid the vision tier; guarantees zero tokens" }
          ]
        },
        "description": "Same as above but returns per-page finder diagnostics in page_scores, and refuses to touch the AI tier."
      }
    },
    {
      "name": "4. Inspect (page finder only, no extraction)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": [] }]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/door-schedule/inspect",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "door-schedule", "inspect"]
        },
        "description": "Scores every page and returns passing_pages plus the score table. No extraction, never any AI. Use this to check a new bid set quickly."
      }
    },
    {
      "name": "5. ERROR — missing API key (expect 401)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": [] }]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/door-schedule/extract",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "door-schedule", "extract"]
        },
        "description": "Expect 401 {\"detail\":\"Invalid API key.\"}"
      }
    },
    {
      "name": "6. ERROR — not a PDF (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": [], "description": "pick any .txt file" }]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/door-schedule/extract",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "door-schedule", "extract"]
        },
        "description": "Expect 400 {\"detail\":\"File is not a readable PDF.\"}"
      }
    }
  ]
}
